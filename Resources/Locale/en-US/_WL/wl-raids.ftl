wl-raid-direction-unknown = unknown direction
wl-raid-direction-north = north
wl-raid-direction-south = south
wl-raid-direction-east = east
wl-raid-direction-west = west

wl-raid-warning-announcement = Raider wave {$wave} is moving toward the settlement from the {$direction}. Estimated contact in {$minutes} minute(s). Last sighting: {$distance} meters out at local coordinates {$x}, {$y}.
wl-raid-spawn-announcement = Raider wave {$wave} has entered the field from the {$direction}. Estimated attackers: {$count}.
wl-raid-spawn-admin-announcement = WL raid: wave {$wave}, raiders {$count}, direction: {$direction}, spawn center: {$x}, {$y}.
