# /// WL Change — FrozenWorld entity names (English)

# --- FrozenWorld materials ---

ent-WLLog = frozen log
    .desc = A heavy frozen trunk. Saw or split it before serious shelter work.

ent-WLLooseScrap = loose scrap
    .desc = Bent metal from old ruins. Useful for crude tools, repairs and early structures.
