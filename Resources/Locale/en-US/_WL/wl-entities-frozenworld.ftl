# /// WL Change — FrozenWorld entity names (English)

# --- Survival clothing T1: Light ---

ent-ClothingOuterWinterCoatLightWL = light insulated coat
    .desc = A thin insulated coat for mild frozen weather and short trips outside.

ent-ClothingUniformJumpsuitThermalLightWL = light thermal jumper
    .desc = A thin thermal jumper for short trips through light cold.

ent-ClothingHeadHatWinterLightWL = light survival hood
    .desc = A thin padded hood for the head and face. Craft and wear separately from the coat.
ent-ClothingHeadHatHoodWinterLightWL = light survival hood
    .desc = { ent-ClothingHeadHatWinterLightWL.desc }

ent-ClothingHandsGlovesWinterLightWL = light winter gloves
    .desc = Thin insulated gloves for handling tools in mild cold.

ent-ClothingShoesBootsWinterLightWL = light winter boots
    .desc = Light insulated boots for short walks over frozen ground.

# --- Survival clothing T2: Warm ---

ent-ClothingOuterWinterCoatWarmWL = warm insulated coat
    .desc = A padded coat for routine work in below-freezing weather.

ent-ClothingUniformJumpsuitThermalWarmWL = warm thermal jumper
    .desc = A padded thermal jumper for regular work below freezing.

ent-ClothingHeadHatWinterWarmWL = warm survival hood
    .desc = A cargo-style hood with thicker lining for routine outdoor work.
ent-ClothingHeadHatHoodWinterWarmWL = warm survival hood
    .desc = { ent-ClothingHeadHatWinterWarmWL.desc }

ent-ClothingHandsGlovesWinterWarmWL = warm winter gloves
    .desc = Padded gloves that keep your fingers useful below freezing.

ent-ClothingShoesBootsWinterWarmWL = warm winter boots
    .desc = Padded boots for regular work over packed snow and ice.

ent-ClothingOuterArmoredWinterCoatWarmWL = warm armored winter coat
    .desc = A padded winter coat with scrap plates sewn under the lining. It keeps warmth in and glancing blows out.

# --- Survival clothing T3: Winter ---

ent-ClothingOuterWinterCoatWL = winter insulated coat
    .desc = A heavy winter coat for sustained exposure to harsh cold.

ent-ClothingUniformJumpsuitWinterWL = winter thermal jumper
    .desc = A heavy thermal jumper for survival in severe cold.

ent-ClothingHeadHatWinterWL = heavy survival hood
    .desc = A miner-style hood with heavy insulation for the head and face.
ent-ClothingHeadHatHoodWinterHeavyWL = heavy survival hood
    .desc = { ent-ClothingHeadHatWinterWL.desc }

ent-ClothingHeadHelmetWinterWL = winter hat
    .desc = Legacy id; same as the T3 winter hat.

ent-ClothingHeadHatHoodWinterWL = winter hat
    .desc = Legacy id; same as the T3 winter hat.

ent-ClothingHandsGlovesWinterWL = winter gloves
    .desc = Heavy insulated gloves for severe cold.

ent-ClothingShoesBootsWinterWL = winter boots
    .desc = Heavy insulated boots built for frozen terrain.

ent-ClothingOuterArmoredWinterCoatWL = armored winter coat
    .desc = A heavy winter coat reinforced with fitted plates and thick hide backing for dangerous patrols.

# --- Survival clothing T4: Arctic ---

ent-ClothingOuterWinterCoatArcticWL = arctic insulated coat
    .desc = A sealed arctic coat for long work in brutal cold.

ent-ClothingUniformJumpsuitThermalArcticWL = arctic thermal jumper
    .desc = A dense thermal jumper made for long exposure to brutal cold.

ent-ClothingHeadHatWinterArcticWL = arctic survival hood
    .desc = A chief-engineer hood with dense lining for brutal cold.
ent-ClothingHeadHatHoodWinterArcticWL = arctic survival hood
    .desc = { ent-ClothingHeadHatWinterArcticWL.desc }

ent-ClothingHandsGlovesWinterArcticWL = arctic winter gloves
    .desc = Dense insulated gloves for long work in brutal cold.

ent-ClothingShoesBootsWinterArcticWL = arctic winter boots
    .desc = Dense insulated boots for long work across frozen terrain.

ent-ClothingOuterArmoredWinterCoatArcticWL = armored arctic coat
    .desc = A sealed arctic coat with layered metal reinforcement for raids, escorts and deep expeditions.

# --- Survival clothing T5: Extreme ---

ent-ClothingOuterWinterCoatExtremeWL = extreme insulated coat
    .desc = A reinforced extreme-weather coat for the deepest freeze.

ent-ClothingUniformJumpsuitThermalExtremeWL = extreme thermal jumper
    .desc = A reinforced thermal jumper for the deepest freeze.

ent-ClothingHeadHatWinterExtremeWL = extreme survival hood
    .desc = A reinforced web-lined hood for the deepest freeze.
ent-ClothingHeadHatHoodWinterExtremeWL = extreme survival hood
    .desc = { ent-ClothingHeadHatWinterExtremeWL.desc }

ent-ClothingHandsGlovesWinterExtremeWL = extreme winter gloves
    .desc = Reinforced insulated gloves for the deepest freeze.

ent-ClothingShoesBootsWinterExtremeWL = extreme winter boots
    .desc = Reinforced insulated boots for the deepest freeze.

ent-ClothingOuterArmoredWinterCoatExtremeWL = extreme armored winter coat
    .desc = A dense expedition coat with heavy armor plates. Built for the worst weather and the worst people.

ent-WLScrapMetalWallBlueprint = scrap metal wall blueprint
    .desc = A personal plan for a cold but sturdy shelter wall.
ent-WLSteelWallBlueprint = steel shelter wall blueprint
    .desc = A personal plan for a sturdy steel shelter wall.
ent-WLReinforcedStoneWallBlueprint = reinforced stone wall blueprint
    .desc = A personal plan for a heavy reinforced shelter wall.
ent-WLScrapMetalWall = scrap metal wall
    .desc = A cold patched wall of bolted scrap plates. It is strong against raids, but terrible at keeping warmth.
ent-WLSteelWall = steel shelter wall
    .desc = A fitted steel plate wall for defended settlement rooms. It takes raids better than scrap plating, but still bleeds heat through the metal.
ent-WLReinforcedStoneWall = reinforced stone wall
    .desc = Thick stonework bound with scrap reinforcement. Expensive, heavy, and fit for a settlement perimeter.
