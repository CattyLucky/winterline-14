<ui:FrozenThermometerWindow
    xmlns="https://spacestation14.io"
    xmlns:ui="clr-namespace:Content.Client._WL.FrozenWorld.UI"
    SetSize="480 150"
    Resizable="True"
    MinWidth="420"
    MinHeight="120">
    <BoxContainer Orientation="Vertical" Margin="12 12 12 12">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Label Name="HeaderLabel" Text="Thermometer" HorizontalExpand="True" />
        </BoxContainer>

        <Control MinSize="1 8" />

        <PanelContainer Name="TemperaturePanel" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical">
                <Label Name="EnvironmentalTemperatureLabel" Text="—" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</ui:FrozenThermometerWindow>
