<ui:FrozenHeatSourceFuelWindow
    xmlns="https://spacestation14.io"
    xmlns:ui="clr-namespace:Content.Client._WL.FrozenWorld.UI"
    Title="Генератор"
    SetSize="580 480"
    Resizable="True"
    MinWidth="500"
    MinHeight="400">
    <BoxContainer Orientation="Vertical" Margin="12 12 12 12">
        <PanelContainer Name="StatusPanel" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <Label Name="StatusLabel" Text="Состояние: нет данных" />
                        <Label Name="ActiveFuelLabel" Text="Активное топливо: —" />
                    </BoxContainer>
                    <Button Name="OpenFuelStorageButton"
                            Text="Открыть/закрыть топливный отсек"
                            MinWidth="150"
                            HorizontalAlignment="Right" />
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <Control MinSize="1 8" />

        <PanelContainer Name="FuelPanel" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical">
                <Label Name="RemainingLabel" Text="Горение: —" />
                <ProgressBar Name="FuelReserveBar" MinSize="0 20" MaxValue="1" />
                <Control MinSize="1 6" />
                <Label Name="QueueLabel" Text="Очередь топлива: —" />
                <Label Name="LastFuelLabel" Text="Последнее топливо: —" />
            </BoxContainer>
        </PanelContainer>

        <Control MinSize="1 8" />

        <PanelContainer Name="HeatPanel" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical">
                <Label Name="HeatLabel" Text="Тепло: —" />
                <Label Name="TransferLabel" Text="Передача тепла: —" />
                <Label Name="RadiusLabel" Text="Радиус: —" />
                <Label Name="BurnRateLabel" Text="Скорость горения: —" />
            </BoxContainer>
        </PanelContainer>

        <Control MinSize="1 8" />

        <PanelContainer Name="HintPanel" HorizontalExpand="True">
            <Label Name="HintLabel"
                   Text="Основное окно показывает работу генератора. Топливо кладётся через кнопку 'Топливный отсек'."
                   HorizontalExpand="True" />
        </PanelContainer>
    </BoxContainer>
</ui:FrozenHeatSourceFuelWindow>
