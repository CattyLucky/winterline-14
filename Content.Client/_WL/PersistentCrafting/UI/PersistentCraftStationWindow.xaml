<ui:PersistentCraftStationWindow
    xmlns="https://spacestation14.io"
    xmlns:ui="clr-namespace:Content.Client._WL.PersistentCrafting.UI"
    Title="{Loc 'persistent-craft-menu-title'}"
    SetSize="1740 1040"
    Resizable="True"
    MinWidth="1480"
    MinHeight="920">
    <BoxContainer Orientation="Vertical" Margin="12 12 12 12">
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 8">
            <Control HorizontalExpand="True" />
            <Button Name="OpenPlacementButton" Access="Public" Text="{Loc 'persistent-craft-station-open-placement'}" Margin="0 0 8 0" />
            <Button Name="OpenResearchButton" Access="Public" Text="{Loc 'persistent-craft-station-open-research'}" />
        </BoxContainer>
        <TabContainer Name="Branches" Access="Public" VerticalExpand="True" />
    </BoxContainer>
</ui:PersistentCraftStationWindow>
